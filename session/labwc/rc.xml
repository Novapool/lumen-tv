<?xml version="1.0"?>
<!-- labwc config for the Lumen session: no decorations, no desktop key bindings. -->
<labwc_config>
  <core>
    <decoration>client</decoration>
  </core>
  <!-- A single binding replaces labwc's defaults (Alt-Tab, Super-Return terminal, ...). -->
  <keyboard>
    <keybind key="W-F12">
      <action name="None"/>
    </keybind>
    <!-- F1 is Lumen's Home key (read straight from evdev, so Lumen still sees
         it), but Chromium opens its help page on F1. A bound key is swallowed
         by labwc so no client gets it. Same for Super_L. The action must be a
         real one: "None" as the only action clears the binding instead
         (labwc-actions(5)), and labwc has no dedicated no-op. -->
    <keybind key="F1">
      <action name="Execute" command="true"/>
    </keybind>
    <keybind key="Super_L">
      <action name="Execute" command="true"/>
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no"/>
    <!-- Flatpak game/media apps run under Xwayland (app_id = X11 WM_CLASS) and
         do not start fullscreen themselves. Matching is case-insensitive globs.
         ToggleFullscreen on map; do not also pass a fullscreen flag to these.
         type="normal" keeps dialogs (VLC's first-run prompt) windowed. -->
    <windowRule identifier="*moonlight*"><action name="ToggleFullscreen"/></windowRule>
    <windowRule identifier="*chiaki*" type="normal"><action name="ToggleFullscreen"/></windowRule>
    <windowRule identifier="vlc" type="normal"><action name="ToggleFullscreen"/></windowRule>
  </windowRules>
</labwc_config>
