<?xml version="1.0"?>
<!-- labwc config for the Lumen session: no decorations, no desktop key bindings. -->
<labwc_config>
  <core>
    <decoration>client</decoration>
  </core>
  <!-- A single binding replaces labwc's defaults (Alt-Tab, Super-Return terminal, ...). -->
  <keyboard>
    <keybind key="W-F12">
      <action name="None"/>
    </keybind>
    <!-- F1 is Lumen's Home key (read straight from evdev, so Lumen still sees
         it), but Chromium opens its help page on F1. Binding it to nothing
         makes labwc swallow it so no client gets it. Same for Super_L. -->
    <keybind key="F1">
      <action name="None"/>
    </keybind>
    <keybind key="Super_L">
      <action name="None"/>
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no"/>
  </windowRules>
</labwc_config>
