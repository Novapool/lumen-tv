# Manual test session: labwc with Lumen as its only client, on tty1 in place of
# lumen.service (start it to test, e.g. a build run by hand). When it exits,
# ExecStopPost starts lumen.service again, so the TV is never left on a black
# screen.
[Unit]
Description=Lumen test session (labwc)
After=systemd-user-sessions.service network-online.target sound.target bluetooth.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=laith
Group=laith
SupplementaryGroups=input video render audio
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
# Optional overrides without sudo (LUMEN_BENCH=1, LUMEN_MODE, SLINT_*).
EnvironmentFile=-/home/laith/.config/lumen-tv/env
ExecStart=/usr/bin/labwc -C /home/laith/lumen-tv/session/labwc -S /home/laith/lumen-tv/session/start-lumen.sh
# "+" runs this as root, so it can start the boot session again whenever this
# one exits. It also runs when lumen.service's own start stops this unit through
# Conflicts= (harmless, lumen.service is already starting), and at shutdown
# systemd refuses the start job (harmless).
ExecStopPost=+/usr/bin/systemctl start --no-block lumen.service
