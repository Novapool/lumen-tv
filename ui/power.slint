// Power screen: Restart Lumen / Reboot / Shut down, each behind a confirm
// step with Cancel focused. Pure view: navigation state lives on AppWindow,
// the actions run in src/power.rs. Flat opaque fills only (Slint rules).

import { Theme } from "theme.slint";

export global PowerText {
    // Row order is the contract with AppWindow and src/power.rs.
    public pure function action(i: int) -> string {
        return i == 0 ? "restart-lumen" : i == 1 ? "reboot" : "poweroff";
    }
    public pure function label(i: int) -> string {
        return i == 0 ? "Restart Lumen" : i == 1 ? "Reboot" : "Shut down";
    }
    public pure function hint(i: int) -> string {
        return i == 0 ? "Restarts the launcher; apps close" : i == 1 ? "Restarts the whole box" : "Turns the box off; unplug and replug to start it";
    }
}

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <length> rem: 16px;

    width: 16 * root.rem;
    height: 4 * root.rem;
    border-radius: 0.6 * root.rem;
    background: root.focused ? Theme.focus-bg : Theme.panel;
    border-width: root.focused ? 0.18 * root.rem : 0px;
    border-color: Theme.text;

    Text {
        text: root.label;
        font-size: 1.6 * root.rem;
        font-weight: root.focused ? 700 : 500;
        color: root.focused ? Theme.text : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PowerScreen inherits Rectangle {
    in property <length> rem: 16px;
    in property <int> sel-row: 0;
    in property <bool> confirm: false;
    in property <int> sel-btn: 0; // confirm: 0 Cancel, 1 the action
    // Set once an action has started (or failed): replaces the controls.
    in property <string> message: "";
    in property <int> message-level: 0; // -1 error

    background: Theme.bg;

    Text {
        x: 6 * root.rem;
        y: 3.4 * root.rem;
        text: "Power";
        font-size: 2 * root.rem;
        font-weight: 750;
        color: Theme.text;
    }

    if root.message != "": Text {
        x: 6 * root.rem;
        y: 12 * root.rem;
        width: root.width - 12 * root.rem;
        text: root.message;
        font-size: 2 * root.rem;
        font-weight: 600;
        wrap: word-wrap;
        color: root.message-level == -1 ? Theme.fail : Theme.text;
    }

    if root.message == "" && !root.confirm: VerticalLayout {
        x: 6 * root.rem;
        y: 12 * root.rem;
        width: 44 * root.rem;
        spacing: 1 * root.rem;

        for i in 3: Rectangle {
            height: 6 * root.rem;
            border-radius: 0.6 * root.rem;
            background: i == root.sel-row ? Theme.focus-bg : Theme.panel;
            border-width: i == root.sel-row ? 0.18 * root.rem : 0px;
            border-color: Theme.text;

            VerticalLayout {
                padding-left: 2 * root.rem;
                alignment: center;
                spacing: 0.3 * root.rem;

                Text {
                    text: PowerText.label(i);
                    font-size: 2 * root.rem;
                    font-weight: i == root.sel-row ? 700 : 500;
                    color: Theme.text;
                }

                Text {
                    text: PowerText.hint(i);
                    font-size: 1.3 * root.rem;
                    color: Theme.muted;
                }
            }
        }
    }

    if root.message == "" && root.confirm: VerticalLayout {
        x: 6 * root.rem;
        y: 12 * root.rem;
        spacing: 3 * root.rem;
        alignment: start;

        Text {
            text: PowerText.label(root.sel-row) + "?";
            font-size: 3 * root.rem;
            font-weight: 750;
            color: Theme.text;
        }

        HorizontalLayout {
            spacing: 2 * root.rem;
            alignment: start;

            Choice {
                label: "Cancel";
                focused: root.sel-btn == 0;
                rem: root.rem;
            }

            Choice {
                label: PowerText.label(root.sel-row);
                focused: root.sel-btn == 1;
                rem: root.rem;
            }
        }
    }
}
