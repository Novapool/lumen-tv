// Lumen's window: the home screen (hero backdrop, title, tile row) and the
// benchmark readout. Everything is sized in rem = 1/120 of the window width
// (16 px at 1080p). Input arrives through nav(): from the evdev input layer
// on the Pi, or from the window's own keys elsewhere (key-nav).

import { Theme } from "theme.slint";
import { App, Tile } from "tile.slint";
import { DiagPanel, DiagRow, SettingsScreen } from "settings.slint";
import { StoreItem, StoreJob, StoreScreen } from "store.slint";
import { DetailsScreen } from "details.slint";

export { DiagPanel, DiagRow, StoreItem, StoreJob }

// The normalized input events (Rust: input::Action).
export enum NavEvent { up, down, left, right, select, back, home, menu, play-pause }

export component AppWindow inherits Window {
    title: "Lumen";
    background: Theme.bg;
    default-font-size: 16px;

    in property <string> clock: "";
    in property <bool> input-locked: false; // during the benchmark
    // Navigate with the window's own key events. Off on the Pi, where the
    // evdev input layer already sees the keyboard.
    in property <bool> key-nav: true;
    // LUMEN_INPUT_DEBUG=1: the last action and its device, briefly.
    in-out property <string> input-debug: "";
    in property <string> perf-text: "";
    in property <string> perf-detail: "";
    in property <int> perf-verdict: 0; // 0 none, 1 pass, -1 fail
    in-out property <int> focused: 0;
    in-out property <bool> pressed: false;
    callback press();
    callback launch(int); // select on the tile at this index
    callback bench();
    callback quit();

    // Settings contract (Rust feeds diag-panels, see src/diag.rs).
    in-out property <bool> settings-open: false;
    in property <[DiagPanel]> diag-panels: [];
    in property <bool> input-debug-on: false;
    callback settings-changed(bool);
    callback toggle-input-debug();
    // Settings navigation state: level 0 = panel list, 1 = rows of `s-panel`.
    property <int> s-level: 0;
    property <int> s-panel: 0;
    property <int> s-row: 0;

    // Store contract (Rust feeds these, see src/store.rs). Navigation state:
    // st-level 0 list, 1 details, 2 confirm, 3 progress.
    in-out property <bool> store-open: false;
    in property <int> store-state: 0; // 0 loading, 1 ready, -1 error
    in property <string> store-message: "";
    in property <string> store-source: "";
    in property <[StoreItem]> store-items: [];
    in property <StoreJob> store-job;
    callback store-changed(bool);
    callback store-reload();
    callback store-run(string, string); // (id, action); only from the confirm screen
    callback store-dismiss();
    property <int> st-level: 0;
    property <int> st-row: 0;
    property <int> st-btn: 0;
    property <int> st-last-row: max(0, root.store-items.length - 1);
    // The item shown on Details/Confirm, copied when Details opens: a job that
    // finishes meanwhile and reloads `store-items` can't change what Run does.
    property <StoreItem> st-item;
    property <int> st-scroll: 0; // Details/Confirm scroll steps

    property <length> rem: self.width / 120;
    property <length> safe-x: 6 * root.rem;
    property <length> safe-y: 3.4 * root.rem;
    property <int> visible-tiles: 5;

    // The apps row: registry entries, then Store and Settings. Built in
    // main.rs, which also bakes each `hero` at startup.
    in-out property <[App]> apps: [];

    // Two backdrop layers: the hidden one gets the new image, then they swap opacity.
    property <image> hero-a: root.apps[0].hero;
    property <image> hero-b: root.apps[0].hero;
    property <int> hero-front: 0;
    // Crossfade weights. The blend is done by blend() in main.rs on the small
    // baked images, so the GPU still draws one backdrop layer: two full-width
    // layers fading at 4K cost ~30 fps of the motion bench.
    property <float> weight-a: root.hero-front == 0 ? 1 : 0;
    property <float> weight-b: root.hero-front == 1 ? 1 : 0;
    animate weight-a, weight-b { duration: 600ms; easing: ease; }
    pure callback blend(image, image, float) -> image; // (a, b, share of b)

    // After the model is replaced (store reload) the visible backdrop would
    // keep the old tile's image until the next focus move.
    changed apps => {
        if (root.hero-front == 0) {
            root.hero-a = root.apps[root.focused].hero;
        } else {
            root.hero-b = root.apps[root.focused].hero;
        }
    }

    // Tile faces and the shared shadow are baked for the current size (main.rs).
    in property <image> tile-shadow;
    callback rebake-tiles(float); // physical pixels per rem
    changed rem => { root.rebake-tiles(self.rem / 1phx); }

    // The row slides so the focused tile stays 2nd from the left.
    property <length> row-offset: max(0, min(root.focused - 1, root.apps.length - root.visible-tiles)) * 22 * root.rem;
    animate row-offset {
        duration: 320ms;
        easing: Theme.ease-out;
    }

    // Moves focus by dir tiles; false at either end of the row.
    public function move(dir: int) -> bool {
        if (root.focused + dir < 0 || root.focused + dir >= root.apps.length) {
            return false;
        }
        root.focused += dir;
        if (root.hero-front == 0) {
            root.hero-b = root.apps[root.focused].hero;
            root.hero-front = 1;
        } else {
            root.hero-a = root.apps[root.focused].hero;
            root.hero-front = 0;
        }
        return true;
    }

    function close-settings() {
        root.settings-open = false;
        root.settings-changed(false);
    }

    function close-store() {
        root.store-open = false;
        root.store-changed(false);
    }

    function store-nav(e: NavEvent) {
        if (e == NavEvent.home) {
            root.close-store();
            return;
        }
        if (root.st-level == 0) {
            if (e == NavEvent.back) {
                root.close-store();
            } else if (root.store-state == -1) {
                if (e == NavEvent.select) {
                    root.store-reload();
                }
            } else if (root.store-state == 1 && root.store-items.length > 0) {
                if (e == NavEvent.up) {
                    root.st-row = max(0, min(root.st-last-row, root.st-row) - 1);
                } else if (e == NavEvent.down) {
                    root.st-row = max(0, min(root.st-last-row, root.st-row + 1));
                } else if (e == NavEvent.right || e == NavEvent.select) {
                    root.st-row = max(0, min(root.st-last-row, root.st-row));
                    root.st-item = root.store-items[root.st-row];
                    root.st-level = 1;
                    root.st-btn = 0;
                    root.st-scroll = 0;
                }
            }
        } else if (root.st-level == 1) {
            // [action, Back]; needs-root apps only have [Back].
            if (e == NavEvent.back) {
                root.st-level = 0;
            } else if (e == NavEvent.up) {
                root.st-scroll = max(0, root.st-scroll - 1);
            } else if (e == NavEvent.down) {
                root.st-scroll += 1; // DetailsScreen clamps it
            } else if (e == NavEvent.left || e == NavEvent.right) {
                if (!root.st-item.needs-root) {
                    root.st-btn = e == NavEvent.left ? 0 : 1;
                }
            } else if (e == NavEvent.select) {
                if (root.st-item.needs-root || root.st-btn == 1) {
                    root.st-level = 0;
                } else {
                    root.st-level = 2;
                    root.st-btn = 0;
                    root.st-scroll = 0;
                }
            }
        } else if (root.st-level == 2) {
            // [Cancel, Run]; Cancel is focused by default.
            if (e == NavEvent.back) {
                root.st-level = 1;
                root.st-btn = 0;
                root.st-scroll = 0;
            } else if (e == NavEvent.up) {
                root.st-scroll = max(0, root.st-scroll - 1);
            } else if (e == NavEvent.down) {
                root.st-scroll += 1;
            } else if (e == NavEvent.left) {
                root.st-btn = 0;
            } else if (e == NavEvent.right) {
                root.st-btn = 1;
            } else if (e == NavEvent.select) {
                if (root.st-btn == 1) {
                    // Never start a second job over a running one.
                    if (root.store-job.state != 1) {
                        root.store-run(root.st-item.id, root.st-item.installed ? "uninstall" : "install");
                        root.st-level = 3;
                    }
                } else {
                    root.st-level = 1;
                    root.st-btn = 0;
                    root.st-scroll = 0;
                }
            }
        } else if (root.st-level == 3) {
            // No cancel while the job runs. Back to the list: its items were reloaded.
            if ((e == NavEvent.select || e == NavEvent.back) && (root.store-job.state == 2 || root.store-job.state == -1)) {
                root.store-dismiss();
                root.st-level = 0;
            }
        }
    }

    // Rows in a panel; the Toggles panel (always last, built by the UI) has 2.
    function settings-rows(p: int) -> int {
        return p >= root.diag-panels.length ? 2 : root.diag-panels[p].rows.length;
    }

    function settings-nav(e: NavEvent) {
        if (e == NavEvent.home) {
            root.close-settings();
        } else if (root.s-level == 0) {
            if (e == NavEvent.back) {
                root.close-settings();
            } else if (e == NavEvent.up) {
                root.s-panel = max(0, root.s-panel - 1);
            } else if (e == NavEvent.down) {
                root.s-panel = min(root.diag-panels.length, root.s-panel + 1);
            } else if ((e == NavEvent.right || e == NavEvent.select) && root.settings-rows(root.s-panel) > 0) {
                root.s-level = 1;
                // Log: newest line is last, start there. Others: first row.
                root.s-row = root.diag-panels[root.s-panel].title == "Log" ? root.settings-rows(root.s-panel) - 1 : 0;
            }
        } else {
            if (e == NavEvent.back || e == NavEvent.left) {
                root.s-level = 0;
            } else if (e == NavEvent.up) {
                root.s-row = max(0, root.s-row - 1);
            } else if (e == NavEvent.down) {
                root.s-row = max(0, min(root.settings-rows(root.s-panel) - 1, root.s-row + 1));
            } else if (e == NavEvent.select && root.s-panel >= root.diag-panels.length) {
                if (root.s-row == 0) {
                    root.toggle-input-debug();
                } else {
                    root.close-settings();
                    root.bench();
                }
            }
        }
    }

    public function nav(e: NavEvent) {
        if (root.input-locked) {
            return;
        }
        if (root.settings-open) {
            root.settings-nav(e);
            return;
        }
        if (root.store-open) {
            root.store-nav(e);
            return;
        }
        if (e == NavEvent.right) {
            root.move(1);
        } else if (e == NavEvent.left) {
            root.move(-1);
        } else if (e == NavEvent.select) {
            root.press();
            if (root.apps[root.focused].id == "lumen:settings") {
                root.s-level = 0;
                root.s-panel = 0;
                root.s-row = 0;
                root.settings-open = true;
                root.settings-changed(true);
            } else if (root.apps[root.focused].id == "lumen:store") {
                // A job that is running (or finished while the store was closed)
                // reopens on its progress view.
                root.st-level = root.store-job.state != 0 ? 3 : 0;
                root.st-row = 0;
                root.st-btn = 0;
                root.store-open = true;
                root.store-changed(true);
            } else {
                root.launch(root.focused);
            }
        } else if (e == NavEvent.home && root.focused != 0) {
            root.move(-root.focused);
        }
        // Up/Down: a single row has nowhere to go. Back/Menu: no screen to
        // leave or menu to open yet.
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "q" || event.text == "Q")) {
                root.quit();
                return accept;
            }
            if (root.key-nav) {
                if (event.text == Key.UpArrow) {
                    root.nav(NavEvent.up);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.nav(NavEvent.down);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.nav(NavEvent.left);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.nav(NavEvent.right);
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    root.nav(NavEvent.select);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.nav(NavEvent.back);
                    return accept;
                }
            }
            if (!root.input-locked && (event.text == "b" || event.text == "B")) {
                root.bench();
                return accept;
            }
            return reject;
        }
    }

    // hero ("top shelf") backdrop: top 65% of the screen. Each app's gradient
    // and fades are baked into one opaque image (src/bake.rs), so at rest this
    // is a single layer: the GPU is fill-rate bound at 4K.
    Rectangle {
        visible: !root.settings-open && !root.store-open;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height * 0.65;

        Image {
            width: 100%;
            height: 100%;
            source: root.blend(root.hero-a, root.hero-b, root.weight-b / max(0.001, root.weight-a + root.weight-b));
            image-fit: fill;
        }
    }

    Text {
        visible: !root.settings-open && !root.store-open;
        x: root.safe-x;
        y: root.safe-y;
        text: "Lumen";
        font-size: 2 * root.rem;
        font-weight: 750;
        color: Theme.text;
    }

    Text {
        visible: !root.settings-open && !root.store-open;
        x: root.width - root.safe-x - self.width;
        y: root.safe-y;
        text: root.clock;
        font-size: 1.9 * root.rem;
        font-weight: 500;
        color: Theme.muted;
    }

    if root.perf-text != "": VerticalLayout {
        visible: !root.settings-open && !root.store-open;
        x: root.width - root.safe-x - self.width;
        y: root.safe-y + 3.5 * root.rem;
        spacing: 0.3 * root.rem;

        Text {
            text: root.perf-text;
            font-size: 1.15 * root.rem;
            font-weight: 600;
            color: root.perf-verdict == 1 ? Theme.pass : root.perf-verdict == -1 ? Theme.fail : Theme.text;
            horizontal-alignment: right;
        }

        if root.perf-detail != "": Text {
            text: root.perf-detail;
            font-size: 1.15 * root.rem;
            color: Theme.muted;
            horizontal-alignment: right;
        }
    }

    Text {
        visible: !root.settings-open && !root.store-open;
        x: root.safe-x;
        y: 14 * root.rem;
        text: root.apps[root.focused].name;
        font-size: 5.2 * root.rem;
        font-weight: 750;
        letter-spacing: -0.02 * 5.2 * root.rem;
        color: Theme.text;
    }

    // tile row, 22rem pitch
    Rectangle {
        visible: !root.settings-open && !root.store-open;
        x: root.safe-x - root.row-offset;
        y: 35 * root.rem;
        width: root.apps.length * 22 * root.rem;
        height: 11.4 * root.rem;

        for app[i] in root.apps: Tile {
            x: i * 22 * root.rem;
            y: 0;
            app: app;
            rem: root.rem;
            focused: i == root.focused;
            pressed: root.pressed && i == root.focused;
            shadow: root.tile-shadow;
        }
    }

    if root.settings-open: SettingsScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        panels: root.diag-panels;
        rem: root.rem;
        input-debug-on: root.input-debug-on;
        level: root.s-level;
        sel-panel: root.s-panel;
        sel-row: root.s-row;
    }

    if root.store-open && (root.st-level == 0 || root.st-level == 3): StoreScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        state: root.store-state;
        message: root.store-message;
        source: root.store-source;
        items: root.store-items;
        job: root.store-job;
        rem: root.rem;
        level: root.st-level;
        sel-row: root.st-row;
        sel-btn: root.st-btn;
    }

    if root.store-open && (root.st-level == 1 || root.st-level == 2): DetailsScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        item: root.st-item;
        rem: root.rem;
        sel-btn: root.st-btn;
        confirm: root.st-level == 2;
        scroll <=> root.st-scroll;
    }

    if root.input-debug != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 7 * root.rem;
        width: debug-text.preferred-width + 3 * root.rem;
        height: 3.4 * root.rem;
        border-radius: self.height / 2;
        background: #ffffff1f;

        debug-text := Text {
            text: root.input-debug;
            font-size: 1.4 * root.rem;
            color: Theme.text;
        }
    }

    Timer {
        interval: 1500ms;
        running: root.input-debug != "";
        triggered => {
            root.input-debug = "";
        }
    }

    TouchArea {
        mouse-cursor: none;
    }
}
