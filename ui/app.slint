// Lumen's window: the home screen (hero backdrop, title, tile row) and the
// benchmark readout. Everything is sized in rem = 1/120 of the window width
// (16 px at 1080p). Input arrives through nav(): from the evdev input layer
// on the Pi, or from the window's own keys elsewhere (key-nav).

import { Theme } from "theme.slint";
import { App, Tile } from "tile.slint";
import { DiagPanel, DiagRow, SettingsScreen } from "settings.slint";
import { BluetoothPanel, BtDevice, BtState, BtText } from "bluetooth.slint";
import { StoreItem, StoreJob, StoreScreen } from "store.slint";
import { DetailsScreen } from "details.slint";
import { PowerScreen, PowerText } from "power.slint";

export { BtDevice, BtState, DiagPanel, DiagRow, StoreItem, StoreJob }

// The normalized input events (Rust: input::Action).
export enum NavEvent { up, down, left, right, select, back, home, menu, play-pause }

export component AppWindow inherits Window {
    title: "Lumen";
    background: Theme.bg;
    default-font-size: 16px;

    in property <string> clock: "";
    in property <bool> input-locked: false; // during the benchmark
    // Navigate with the window's own key events. Off on the Pi, where the
    // evdev input layer already sees the keyboard.
    in property <bool> key-nav: true;
    // LUMEN_INPUT_DEBUG=1: the last action and its device, briefly.
    in-out property <string> input-debug: "";
    in property <string> perf-text: "";
    in property <string> perf-detail: "";
    in property <int> perf-verdict: 0; // 0 none, 1 pass, -1 fail
    in-out property <int> focused: 0;
    in-out property <bool> pressed: false;
    callback press();
    callback launch(int); // select on the tile at this index
    callback bench();
    callback quit();

    // Settings contract (Rust feeds diag-panels, see src/diag.rs).
    in-out property <bool> settings-open: false;
    in property <[DiagPanel]> diag-panels: [];
    in property <bool> input-debug-on: false;
    callback settings-changed(bool);
    callback toggle-input-debug();
    in property <string> resolution-detail: "";
    in property <int> resolution-level: 0;
    callback toggle-resolution();
    // Settings navigation state: level 0 = panel list, 1 = rows of `s-panel`.
    property <int> s-level: 0;
    property <int> s-panel: 0;
    property <int> s-row: 0;
    property <int> s-bt-btn: 0;
    // Bluetooth contract (Rust feeds bt-devices/bt-state, see src/bluetooth.rs).
    // s-level 2 = action sheet, 3 = confirm (Bluetooth panel only).
    in property <[BtDevice]> bt-devices: [];
    in property <BtState> bt-state;
    // The device the sheet/confirm act on, copied when the sheet opens: a list
    // refresh can't retarget the action. bt-pending = action awaiting confirm.
    property <BtDevice> bt-item;
    property <string> bt-pending: "";
    property <bool> bt-active: false; // bt-changed(true) sent and not yet undone
    callback bt-changed(bool); // panel opened or closed: Rust starts/stops polling and scanning
    callback bt-leave-rows(); // Back/Left from the device rows to the panel list: Rust stops Lumen's scan
    callback bt-scan(); // toggles the scan; powers the adapter on when it's off
    callback bt-action(string, string); // (address, "pair"|"connect"|"disconnect"|"forget")
    callback nav-trace(string); // one human line after every nav(); Rust prints it only while input debug is on

    // Store contract (Rust feeds these, see src/store.rs). Navigation state:
    // st-level 0 list, 1 details, 2 confirm, 3 progress.
    in-out property <bool> store-open: false;
    in property <int> store-state: 0; // 0 loading, 1 ready, -1 error
    in property <string> store-message: "";
    in property <string> store-source: "";
    in property <[StoreItem]> store-items: [];
    in property <StoreJob> store-job;
    callback store-changed(bool);
    callback store-reload();
    callback store-run(string, string); // (id, action); only from the confirm screen
    callback store-dismiss();
    property <int> st-level: 0;
    property <int> st-row: 0;
    property <int> st-btn: 0;
    property <int> st-last-row: max(0, root.store-items.length - 1);
    // The item shown on Details/Confirm, copied when Details opens: a job that
    // finishes meanwhile and reloads `store-items` can't change what Run does.
    property <StoreItem> st-item;
    property <int> st-scroll: 0; // Details/Confirm scroll steps

    // Power contract (src/power.rs). pw-confirm: the confirm step for pw-row.
    in-out property <bool> power-open: false;
    in property <string> power-message: ""; // set by Rust once an action starts or fails
    in property <int> power-message-level: 0;
    callback power-action(string); // PowerText.action(row), only from the confirm step
    callback power-changed(bool);
    property <int> pw-row: 0;
    property <bool> pw-confirm: false;
    property <int> pw-btn: 0;

    property <length> rem: self.width / 120;
    property <length> safe-x: 6 * root.rem;
    property <length> safe-y: 3.4 * root.rem;
    property <int> visible-tiles: 5;

    // The apps row: registry entries, then Store, Settings and Power. Built in
    // main.rs, which also bakes each `hero` at startup.
    in-out property <[App]> apps: [];

    // Two backdrop layers: the hidden one gets the new image, then they swap opacity.
    property <image> hero-a: root.apps[0].hero;
    property <image> hero-b: root.apps[0].hero;
    property <int> hero-front: 0;
    // Crossfade weights. The blend is done by blend() in main.rs on the small
    // baked images, so the GPU still draws one backdrop layer: two full-width
    // layers fading at 4K cost ~30 fps of the motion bench.
    property <float> weight-a: root.hero-front == 0 ? 1 : 0;
    property <float> weight-b: root.hero-front == 1 ? 1 : 0;
    animate weight-a, weight-b { duration: 600ms; easing: ease; }
    pure callback blend(image, image, float) -> image; // (a, b, share of b)

    // After the model is replaced (store reload) the visible backdrop would
    // keep the old tile's image until the next focus move.
    changed apps => {
        if (root.hero-front == 0) {
            root.hero-a = root.apps[root.focused].hero;
        } else {
            root.hero-b = root.apps[root.focused].hero;
        }
    }

    // Tile faces and the shared shadow are baked for the current size (main.rs).
    in property <image> tile-shadow;
    callback rebake-tiles(float); // physical pixels per rem
    changed rem => { root.rebake-tiles(self.rem / 1phx); }

    // The row slides so the focused tile stays 2nd from the left.
    property <length> row-offset: max(0, min(root.focused - 1, root.apps.length - root.visible-tiles)) * 22 * root.rem;
    animate row-offset {
        duration: 320ms;
        easing: Theme.ease-out;
    }

    // Moves focus by dir tiles; false at either end of the row.
    public function move(dir: int) -> bool {
        if (root.focused + dir < 0 || root.focused + dir >= root.apps.length) {
            return false;
        }
        root.focused += dir;
        if (root.hero-front == 0) {
            root.hero-b = root.apps[root.focused].hero;
            root.hero-front = 1;
        } else {
            root.hero-a = root.apps[root.focused].hero;
            root.hero-front = 0;
        }
        return true;
    }

    // Tells Rust when the Bluetooth panel is showing (selected in the panel
    // list, or any deeper level) so it polls and scans only then.
    function bt-sync() {
        if ((root.settings-open && root.s-panel == root.diag-panels.length) != root.bt-active) {
            root.bt-active = !root.bt-active;
            root.bt-changed(root.bt-active);
        }
    }

    function close-settings() {
        root.settings-open = false;
        root.s-level = 0;
        root.bt-sync();
        root.settings-changed(false);
    }

    // Keep the Bluetooth row inside the list when devices drop out.
    changed bt-devices => {
        if (root.s-level == 1 && root.s-panel == root.diag-panels.length) {
            root.s-row = max(0, min(root.bt-devices.length, root.s-row));
        }
    }

    function bt-back-to-rows() {
        root.s-level = 1;
        root.s-bt-btn = 0;
    }

    // Bluetooth levels 1..3. Up/Down move rows; 2 = action sheet; 3 = confirm.
    function bt-nav(e: NavEvent) {
        if (root.s-level == 1) {
            if (e == NavEvent.back || e == NavEvent.left) {
                root.s-level = 0;
                root.bt-leave-rows();
            } else if (e == NavEvent.up) {
                root.s-row = max(0, min(root.bt-devices.length, root.s-row) - 1);
            } else if (e == NavEvent.down) {
                root.s-row = max(0, min(root.bt-devices.length, root.s-row + 1));
            } else if (e == NavEvent.select) {
                root.s-row = max(0, min(root.bt-devices.length, root.s-row));
                if (root.s-row == 0) {
                    if (root.bt-state.available) {
                        root.bt-scan();
                    }
                } else if (!root.bt-devices[root.s-row - 1].busy) {
                    root.bt-item = root.bt-devices[root.s-row - 1];
                    root.s-level = 2;
                    root.s-bt-btn = 0;
                }
            }
        } else if (root.s-level == 2) {
            if (e == NavEvent.back) {
                root.bt-back-to-rows();
            } else if (e == NavEvent.left) {
                root.s-bt-btn = max(0, root.s-bt-btn - 1);
            } else if (e == NavEvent.right) {
                root.s-bt-btn = min(BtText.sheet-count(root.bt-item) - 1, root.s-bt-btn + 1);
            } else if (e == NavEvent.select) {
                if (BtText.sheet-action(root.bt-item, root.s-bt-btn) == "") {
                    root.bt-back-to-rows();
                } else if (BtText.sheet-action(root.bt-item, root.s-bt-btn) == "pair" || BtText.sheet-action(root.bt-item, root.s-bt-btn) == "forget") {
                    root.bt-pending = BtText.sheet-action(root.bt-item, root.s-bt-btn);
                    root.s-level = 3;
                    root.s-bt-btn = 0; // Cancel first
                } else {
                    root.bt-action(root.bt-item.address, BtText.sheet-action(root.bt-item, root.s-bt-btn));
                    root.bt-back-to-rows();
                }
            }
        } else if (root.s-level == 3) {
            // [Cancel, confirm]; Cancel is focused by default.
            if (e == NavEvent.back) {
                root.s-level = 2;
                root.s-bt-btn = 0;
            } else if (e == NavEvent.left) {
                root.s-bt-btn = 0;
            } else if (e == NavEvent.right) {
                root.s-bt-btn = 1;
            } else if (e == NavEvent.select) {
                if (root.s-bt-btn == 1) {
                    root.bt-action(root.bt-item.address, root.bt-pending);
                    root.bt-back-to-rows();
                } else {
                    root.s-level = 2;
                    root.s-bt-btn = 0;
                }
            }
        }
    }

    function close-store() {
        root.store-open = false;
        root.store-changed(false);
    }

    function store-nav(e: NavEvent) {
        if (e == NavEvent.home) {
            root.close-store();
            return;
        }
        if (root.st-level == 0) {
            if (e == NavEvent.back) {
                root.close-store();
            } else if (root.store-state == -1) {
                if (e == NavEvent.select) {
                    root.store-reload();
                }
            } else if (root.store-state == 1 && root.store-items.length > 0) {
                if (e == NavEvent.up) {
                    root.st-row = max(0, min(root.st-last-row, root.st-row) - 1);
                } else if (e == NavEvent.down) {
                    root.st-row = max(0, min(root.st-last-row, root.st-row + 1));
                } else if (e == NavEvent.right || e == NavEvent.select) {
                    root.st-row = max(0, min(root.st-last-row, root.st-row));
                    root.st-item = root.store-items[root.st-row];
                    root.st-level = 1;
                    root.st-btn = 0;
                    root.st-scroll = 0;
                }
            }
        } else if (root.st-level == 1) {
            // [action, Back]; needs-root apps only have [Back].
            if (e == NavEvent.back) {
                root.st-level = 0;
            } else if (e == NavEvent.up) {
                root.st-scroll = max(0, root.st-scroll - 1);
            } else if (e == NavEvent.down) {
                root.st-scroll += 1; // DetailsScreen clamps it
            } else if (e == NavEvent.left || e == NavEvent.right) {
                if (!root.st-item.needs-root) {
                    root.st-btn = e == NavEvent.left ? 0 : 1;
                }
            } else if (e == NavEvent.select) {
                if (root.st-item.needs-root || root.st-btn == 1) {
                    root.st-level = 0;
                } else {
                    root.st-level = 2;
                    root.st-btn = 0;
                    root.st-scroll = 0;
                }
            }
        } else if (root.st-level == 2) {
            // [Cancel, Run]; Cancel is focused by default.
            if (e == NavEvent.back) {
                root.st-level = 1;
                root.st-btn = 0;
                root.st-scroll = 0;
            } else if (e == NavEvent.up) {
                root.st-scroll = max(0, root.st-scroll - 1);
            } else if (e == NavEvent.down) {
                root.st-scroll += 1;
            } else if (e == NavEvent.left) {
                root.st-btn = 0;
            } else if (e == NavEvent.right) {
                root.st-btn = 1;
            } else if (e == NavEvent.select) {
                if (root.st-btn == 1) {
                    // Never start a second job over a running one.
                    if (root.store-job.state != 1) {
                        root.store-run(root.st-item.id, root.st-item.installed ? "uninstall" : "install");
                        root.st-level = 3;
                    }
                } else {
                    root.st-level = 1;
                    root.st-btn = 0;
                    root.st-scroll = 0;
                }
            }
        } else if (root.st-level == 3) {
            // No cancel while the job runs. Back to the list: its items were reloaded.
            if ((e == NavEvent.select || e == NavEvent.back) && (root.store-job.state == 2 || root.store-job.state == -1)) {
                root.store-dismiss();
                root.st-level = 0;
            }
        }
    }

    function close-power() {
        root.power-open = false;
        root.power-changed(false);
    }

    function power-nav(e: NavEvent) {
        if (e == NavEvent.home) {
            root.close-power();
        } else if (!root.pw-confirm) {
            if (e == NavEvent.back) {
                root.close-power();
            } else if (e == NavEvent.up) {
                root.pw-row = max(0, root.pw-row - 1);
            } else if (e == NavEvent.down) {
                root.pw-row = min(2, root.pw-row + 1);
            } else if (e == NavEvent.select || e == NavEvent.right) {
                root.pw-confirm = true;
                root.pw-btn = 0; // Cancel first
            }
        } else {
            // [Cancel, action]
            if (e == NavEvent.back) {
                root.pw-confirm = false;
            } else if (e == NavEvent.left) {
                root.pw-btn = 0;
            } else if (e == NavEvent.right) {
                root.pw-btn = 1;
            } else if (e == NavEvent.select) {
                if (root.pw-btn == 1) {
                    root.power-action(PowerText.action(root.pw-row));
                }
                root.pw-confirm = false;
            }
        }
    }

    // Rows in a panel; Bluetooth (index panels.length) and Toggles (index
    // panels.length + 1, always last) are built by the UI. Bluetooth is a
    // placeholder: one scan row plus the devices.
    function settings-rows(p: int) -> int {
        return p > root.diag-panels.length ? 3 : p == root.diag-panels.length ? root.bt-devices.length + 1 : root.diag-panels[p].rows.length;
    }

    function settings-nav(e: NavEvent) {
        if (e == NavEvent.home) {
            root.close-settings();
        } else if (root.s-level > 0 && root.s-panel == root.diag-panels.length) {
            root.bt-nav(e);
        } else if (root.s-level == 0) {
            if (e == NavEvent.back) {
                root.close-settings();
            } else if (e == NavEvent.up) {
                root.s-panel = max(0, root.s-panel - 1);
                root.bt-sync();
            } else if (e == NavEvent.down) {
                root.s-panel = min(root.diag-panels.length + 1, root.s-panel + 1);
                root.bt-sync();
            } else if ((e == NavEvent.right || e == NavEvent.select) && root.settings-rows(root.s-panel) > 0) {
                root.s-level = 1;
                // Log: newest line is last, start there. Others: first row.
                root.s-row = root.diag-panels[root.s-panel].title == "Log" ? root.settings-rows(root.s-panel) - 1 : 0;
            }
        } else {
            if (e == NavEvent.back || e == NavEvent.left) {
                root.s-level = 0;
            } else if (e == NavEvent.up) {
                root.s-row = max(0, root.s-row - 1);
            } else if (e == NavEvent.down) {
                root.s-row = max(0, min(root.settings-rows(root.s-panel) - 1, root.s-row + 1));
            } else if (e == NavEvent.select && root.s-panel > root.diag-panels.length) {
                if (root.s-row == 0) {
                    root.toggle-resolution();
                } else if (root.s-row == 1) {
                    root.toggle-input-debug();
                } else {
                    root.close-settings();
                    root.bench();
                }
            }
        }
    }

    // One line describing where focus is now, for the input-debug log.
    function trace-line(e: NavEvent) -> string {
        if (root.settings-open) {
            if (root.s-level == 3) {
                return "bt confirm \{root.bt-pending} \{root.bt-item.address} btn=\{root.s-bt-btn == 0 ? "Cancel" : BtText.action-label(root.bt-pending)}";
            }
            if (root.s-level == 2) {
                return "bt sheet \{root.bt-item.address} btn=\{BtText.action-label(BtText.sheet-action(root.bt-item, root.s-bt-btn))}";
            }
            return "settings panel=\{root.s-panel == root.diag-panels.length ? "Bluetooth" : root.s-panel > root.diag-panels.length ? "Toggles" : root.diag-panels[root.s-panel].title} level=\{root.s-level} row=\{root.s-row} \"\{root.s-level == 0 ? "" : root.s-panel == root.diag-panels.length ? (root.s-row == 0 ? BtText.scan-label(root.bt-state) : root.bt-devices[root.s-row - 1].name) : root.s-panel > root.diag-panels.length ? (root.s-row == 0 ? "Resolution" : root.s-row == 1 ? "Input debug" : "Run benchmark") : root.diag-panels[root.s-panel].rows[root.s-row].text}\"";
        }
        if (root.power-open) {
            return "power row=\{PowerText.action(root.pw-row)} confirm=\{root.pw-confirm ? "yes" : "no"} btn=\{root.pw-btn}";
        }
        if (root.store-open) {
            return "store level=\{root.st-level} row=\{root.st-row}";
        }
        return "home focus=\{root.apps[root.focused].id}";
    }

    public function nav(e: NavEvent) {
        root.nav-step(e);
        root.nav-trace(root.trace-line(e));
    }

    function nav-step(e: NavEvent) {
        if (root.input-locked) {
            return;
        }
        if (root.settings-open) {
            root.settings-nav(e);
            return;
        }
        if (root.store-open) {
            root.store-nav(e);
            return;
        }
        if (root.power-open) {
            // An action is under way (or failed): only Home/Back leave.
            if (root.power-message == "" || e == NavEvent.home || e == NavEvent.back) {
                root.power-nav(root.power-message == "" ? e : NavEvent.home);
            }
            return;
        }
        if (e == NavEvent.right) {
            root.move(1);
        } else if (e == NavEvent.left) {
            root.move(-1);
        } else if (e == NavEvent.select) {
            root.press();
            if (root.apps[root.focused].id == "lumen:settings") {
                root.s-level = 0;
                root.s-panel = 0;
                root.s-row = 0;
                root.settings-open = true;
                root.bt-sync();
                root.settings-changed(true);
            } else if (root.apps[root.focused].id == "lumen:store") {
                // A job that is running (or finished while the store was closed)
                // reopens on its progress view.
                root.st-level = root.store-job.state != 0 ? 3 : 0;
                root.st-row = 0;
                root.st-btn = 0;
                root.store-open = true;
                root.store-changed(true);
            } else if (root.apps[root.focused].id == "lumen:power") {
                root.pw-row = 0;
                root.pw-confirm = false;
                root.pw-btn = 0;
                root.power-open = true;
                root.power-changed(true);
            } else {
                root.launch(root.focused);
            }
        } else if (e == NavEvent.home && root.focused != 0) {
            root.move(-root.focused);
        }
        // Up/Down: a single row has nowhere to go. Back/Menu: no screen to
        // leave or menu to open yet.
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "q" || event.text == "Q")) {
                root.quit();
                return accept;
            }
            if (root.key-nav) {
                if (event.text == Key.UpArrow) {
                    root.nav(NavEvent.up);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.nav(NavEvent.down);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.nav(NavEvent.left);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.nav(NavEvent.right);
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    root.nav(NavEvent.select);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.nav(NavEvent.back);
                    return accept;
                }
            }
            if (!root.input-locked && (event.text == "b" || event.text == "B")) {
                root.bench();
                return accept;
            }
            return reject;
        }
    }

    // hero ("top shelf") backdrop: top 65% of the screen. Each app's gradient
    // and fades are baked into one opaque image (src/bake.rs), so at rest this
    // is a single layer: the GPU is fill-rate bound at 4K.
    Rectangle {
        visible: !root.settings-open && !root.store-open && !root.power-open;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height * 0.65;

        Image {
            width: 100%;
            height: 100%;
            source: root.blend(root.hero-a, root.hero-b, root.weight-b / max(0.001, root.weight-a + root.weight-b));
            image-fit: fill;
        }
    }

    Text {
        visible: !root.settings-open && !root.store-open && !root.power-open;
        x: root.safe-x;
        y: root.safe-y;
        text: "Lumen";
        font-size: 2 * root.rem;
        font-weight: 750;
        color: Theme.text;
    }

    Text {
        visible: !root.settings-open && !root.store-open && !root.power-open;
        x: root.width - root.safe-x - self.width;
        y: root.safe-y;
        text: root.clock;
        font-size: 1.9 * root.rem;
        font-weight: 500;
        color: Theme.muted;
    }

    if root.perf-text != "": VerticalLayout {
        visible: !root.settings-open && !root.store-open && !root.power-open;
        x: root.width - root.safe-x - self.width;
        y: root.safe-y + 3.5 * root.rem;
        spacing: 0.3 * root.rem;

        Text {
            text: root.perf-text;
            font-size: 1.15 * root.rem;
            font-weight: 600;
            color: root.perf-verdict == 1 ? Theme.pass : root.perf-verdict == -1 ? Theme.fail : Theme.text;
            horizontal-alignment: right;
        }

        if root.perf-detail != "": Text {
            text: root.perf-detail;
            font-size: 1.15 * root.rem;
            color: Theme.muted;
            horizontal-alignment: right;
        }
    }

    Text {
        visible: !root.settings-open && !root.store-open && !root.power-open;
        x: root.safe-x;
        y: 14 * root.rem;
        text: root.apps[root.focused].name;
        font-size: 5.2 * root.rem;
        font-weight: 750;
        letter-spacing: -0.02 * 5.2 * root.rem;
        color: Theme.text;
    }

    // tile row, 22rem pitch
    Rectangle {
        visible: !root.settings-open && !root.store-open && !root.power-open;
        x: root.safe-x - root.row-offset;
        y: 35 * root.rem;
        width: root.apps.length * 22 * root.rem;
        height: 11.4 * root.rem;

        for app[i] in root.apps: Tile {
            x: i * 22 * root.rem;
            y: 0;
            app: app;
            rem: root.rem;
            focused: i == root.focused;
            pressed: root.pressed && i == root.focused;
            shadow: root.tile-shadow;
        }
    }

    if root.settings-open: SettingsScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        panels: root.diag-panels;
        rem: root.rem;
        input-debug-on: root.input-debug-on;
        resolution-detail: root.resolution-detail;
        resolution-level: root.resolution-level;
        level: root.s-level;
        sel-panel: root.s-panel;
        sel-row: root.s-row;
        sel-bt-btn: root.s-bt-btn;
        bt-devices: root.bt-devices;
        bt-state: root.bt-state;
        bt-item: root.bt-item;
        bt-pending: root.bt-pending;
    }

    if root.store-open && (root.st-level == 0 || root.st-level == 3): StoreScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        state: root.store-state;
        message: root.store-message;
        source: root.store-source;
        items: root.store-items;
        job: root.store-job;
        rem: root.rem;
        level: root.st-level;
        sel-row: root.st-row;
        sel-btn: root.st-btn;
    }

    if root.store-open && (root.st-level == 1 || root.st-level == 2): DetailsScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        item: root.st-item;
        rem: root.rem;
        sel-btn: root.st-btn;
        confirm: root.st-level == 2;
        scroll <=> root.st-scroll;
    }

    if root.power-open: PowerScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        rem: root.rem;
        sel-row: root.pw-row;
        confirm: root.pw-confirm;
        sel-btn: root.pw-btn;
        message: root.power-message;
        message-level: root.power-message-level;
    }

    if root.input-debug != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 7 * root.rem;
        width: debug-text.preferred-width + 3 * root.rem;
        height: 3.4 * root.rem;
        border-radius: self.height / 2;
        background: #ffffff1f;

        debug-text := Text {
            text: root.input-debug;
            font-size: 1.4 * root.rem;
            color: Theme.text;
        }
    }

    Timer {
        interval: 1500ms;
        running: root.input-debug != "";
        triggered => {
            root.input-debug = "";
        }
    }

    TouchArea {
        mouse-cursor: none;
    }
}
