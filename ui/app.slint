// Lumen's window: the home screen (hero backdrop, title, tile row) and the
// benchmark readout. Everything is sized in rem = 1/120 of the window width
// (16 px at 1080p). Input arrives through nav(): from the evdev input layer
// on the Pi, or from the window's own keys elsewhere (key-nav).

import { Theme } from "theme.slint";
import { App, Tile } from "tile.slint";

// The normalized input events (Rust: input::Action).
export enum NavEvent { up, down, left, right, select, back, home, menu, play-pause }

export component AppWindow inherits Window {
    title: "Lumen";
    background: Theme.bg;
    default-font-size: 16px;

    in property <string> clock: "";
    in property <bool> input-locked: false; // during the benchmark
    // Navigate with the window's own key events. Off on the Pi, where the
    // evdev input layer already sees the keyboard.
    in property <bool> key-nav: true;
    // LUMEN_INPUT_DEBUG=1: the last action and its device, briefly.
    in-out property <string> input-debug: "";
    in property <string> perf-text: "";
    in property <string> perf-detail: "";
    in property <int> perf-verdict: 0; // 0 none, 1 pass, -1 fail
    in-out property <int> focused: 0;
    in-out property <bool> pressed: false;
    callback press();
    callback bench();
    callback quit();

    property <length> rem: self.width / 120;
    property <length> safe-x: 6 * root.rem;
    property <length> safe-y: 3.4 * root.rem;
    property <int> visible-tiles: 5;

    // Placeholder apps until the registry (M3) supplies them. main.rs bakes
    // each `hero` from `bg` at startup.
    in-out property <[App]> apps: [
        { name: "Jellyfin", glyph: "J", bg: @linear-gradient(135deg, #6b2fb3 0%, #00a4dc 100%) },
        { name: "Plex", glyph: "P", bg: @linear-gradient(135deg, #1f1f1f 0%, #3a2a05 60%, #e5a00d 100%) },
        { name: "Steam Link", glyph: "S", bg: @linear-gradient(135deg, #0b1a33 0%, #1b6fd1 100%) },
        { name: "Kodi", glyph: "K", bg: @linear-gradient(135deg, #0d3b5c 0%, #17b2e7 100%) },
        { name: "YouTube", glyph: "Y", bg: @linear-gradient(135deg, #5a0000 0%, #ff2a2a 100%) },
        { name: "Games", glyph: "G", bg: @linear-gradient(135deg, #0f3d1e 0%, #3ccf6e 100%) },
        { name: "Screen Mirror", glyph: "M", bg: @linear-gradient(135deg, #3b3f48 0%, #b9c0cc 100%) },
        { name: "Music", glyph: "♪", bg: @linear-gradient(135deg, #5c0a3a 0%, #ff4f8b 100%) },
        { name: "Photos", glyph: "F", bg: @linear-gradient(135deg, #5a3a00 0%, #ffc23d 100%) },
        { name: "Weather", glyph: "W", bg: @linear-gradient(135deg, #0a2e5c 0%, #5fb4ff 100%) },
        { name: "Store", glyph: "+", bg: @linear-gradient(135deg, #003b3b 0%, #19c3b0 100%) },
        { name: "Settings", glyph: "⚙", bg: @linear-gradient(135deg, #24262c 0%, #6b707c 100%) },
    ];

    // Two backdrop layers: the hidden one gets the new image, then they swap opacity.
    property <image> hero-a: root.apps[0].hero;
    property <image> hero-b: root.apps[0].hero;
    property <int> hero-front: 0;
    // Crossfade weights. The blend is done by blend() in main.rs on the small
    // baked images, so the GPU still draws one backdrop layer: two full-width
    // layers fading at 4K cost ~30 fps of the motion bench.
    property <float> weight-a: root.hero-front == 0 ? 1 : 0;
    property <float> weight-b: root.hero-front == 1 ? 1 : 0;
    animate weight-a, weight-b { duration: 600ms; easing: ease; }
    pure callback blend(image, image, float) -> image; // (a, b, share of b)

    // Tile faces and the shared shadow are baked for the current size (main.rs).
    in property <image> tile-shadow;
    callback rebake-tiles(float); // physical pixels per rem
    changed rem => { root.rebake-tiles(self.rem / 1phx); }

    // The row slides so the focused tile stays 2nd from the left.
    property <length> row-offset: max(0, min(root.focused - 1, root.apps.length - root.visible-tiles)) * 22 * root.rem;
    animate row-offset {
        duration: 320ms;
        easing: Theme.ease-out;
    }

    // Moves focus by dir tiles; false at either end of the row.
    public function move(dir: int) -> bool {
        if (root.focused + dir < 0 || root.focused + dir >= root.apps.length) {
            return false;
        }
        root.focused += dir;
        if (root.hero-front == 0) {
            root.hero-b = root.apps[root.focused].hero;
            root.hero-front = 1;
        } else {
            root.hero-a = root.apps[root.focused].hero;
            root.hero-front = 0;
        }
        return true;
    }

    public function nav(e: NavEvent) {
        if (root.input-locked) {
            return;
        }
        if (e == NavEvent.right) {
            root.move(1);
        } else if (e == NavEvent.left) {
            root.move(-1);
        } else if (e == NavEvent.select) {
            root.press();
        } else if (e == NavEvent.home && root.focused != 0) {
            root.move(-root.focused);
        }
        // Up/Down: a single row has nowhere to go. Back/Menu: no screen to
        // leave or menu to open yet.
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "q" || event.text == "Q")) {
                root.quit();
                return accept;
            }
            if (root.key-nav) {
                if (event.text == Key.UpArrow) {
                    root.nav(NavEvent.up);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.nav(NavEvent.down);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.nav(NavEvent.left);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.nav(NavEvent.right);
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    root.nav(NavEvent.select);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.nav(NavEvent.back);
                    return accept;
                }
            }
            if (!root.input-locked && (event.text == "b" || event.text == "B")) {
                root.bench();
                return accept;
            }
            return reject;
        }
    }

    // hero ("top shelf") backdrop: top 65% of the screen. Each app's gradient
    // and fades are baked into one opaque image (src/bake.rs), so at rest this
    // is a single layer: the GPU is fill-rate bound at 4K.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height * 0.65;

        Image {
            width: 100%;
            height: 100%;
            source: root.blend(root.hero-a, root.hero-b, root.weight-b / max(0.001, root.weight-a + root.weight-b));
            image-fit: fill;
        }
    }

    Text {
        x: root.safe-x;
        y: root.safe-y;
        text: "Lumen";
        font-size: 2 * root.rem;
        font-weight: 750;
        color: Theme.text;
    }

    Text {
        x: root.width - root.safe-x - self.width;
        y: root.safe-y;
        text: root.clock;
        font-size: 1.9 * root.rem;
        font-weight: 500;
        color: Theme.muted;
    }

    if root.perf-text != "": VerticalLayout {
        x: root.width - root.safe-x - self.width;
        y: root.safe-y + 3.5 * root.rem;
        spacing: 0.3 * root.rem;

        Text {
            text: root.perf-text;
            font-size: 1.15 * root.rem;
            font-weight: 600;
            color: root.perf-verdict == 1 ? Theme.pass : root.perf-verdict == -1 ? Theme.fail : Theme.text;
            horizontal-alignment: right;
        }

        if root.perf-detail != "": Text {
            text: root.perf-detail;
            font-size: 1.15 * root.rem;
            color: Theme.muted;
            horizontal-alignment: right;
        }
    }

    Text {
        x: root.safe-x;
        y: 14 * root.rem;
        text: root.apps[root.focused].name;
        font-size: 5.2 * root.rem;
        font-weight: 750;
        letter-spacing: -0.02 * 5.2 * root.rem;
        color: Theme.text;
    }

    // tile row, 22rem pitch
    Rectangle {
        x: root.safe-x - root.row-offset;
        y: 35 * root.rem;
        width: root.apps.length * 22 * root.rem;
        height: 11.4 * root.rem;

        for app[i] in root.apps: Tile {
            x: i * 22 * root.rem;
            y: 0;
            app: app;
            rem: root.rem;
            focused: i == root.focused;
            pressed: root.pressed && i == root.focused;
            shadow: root.tile-shadow;
        }
    }

    if root.input-debug != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 7 * root.rem;
        width: debug-text.preferred-width + 3 * root.rem;
        height: 3.4 * root.rem;
        border-radius: self.height / 2;
        background: #ffffff1f;

        debug-text := Text {
            text: root.input-debug;
            font-size: 1.4 * root.rem;
            color: Theme.text;
        }
    }

    Timer {
        interval: 1500ms;
        running: root.input-debug != "";
        triggered => {
            root.input-debug = "";
        }
    }

    TouchArea {
        mouse-cursor: none;
    }
}
