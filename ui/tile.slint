// One app tile. Sized in rem (1/120 of the window width) like the rest of the UI.
//
// The face (gradient, gloss, rounded corners) and the focus shadow are images
// baked in src/bake.rs: at 4K the Pi 5 GPU is fill-rate bound, and Slint
// re-blurred the live drop shadow each time a tile gained focus.

import { Theme } from "theme.slint";

export struct App {
    id: string, // registry id; empty for the built-in Store and Settings tiles
    running: bool, // the app is running or launching: draws the dot
    name: string,
    glyph: string,
    bg: brush, // source of the baked hero and face images
    hero: image, // baked backdrop (src/bake.rs), filled in at startup
    face: image, // baked tile face, re-baked when the window size changes
}

export component Tile inherits Rectangle {
    in property <App> app;
    in property <bool> focused;
    in property <bool> pressed;
    in property <length> rem;
    in property <image> shadow; // shared by all tiles

    // Focus grows the face to 1.12 and fades in the shadow and name (240 / 200 ms).
    // Press shrinks it to 1.05 in 90 ms; release springs back in 240 ms.
    property <float> s: !root.focused ? 1 : root.pressed ? 1.05 : 1.12;
    property <float> lift: root.focused ? 1 : 0;
    property <float> name-opacity: root.focused ? 1 : 0;
    animate s {
        duration: root.pressed ? 90ms : 240ms;
        easing: Theme.ease-out;
    }
    animate lift {
        duration: 240ms;
        easing: Theme.ease-out;
    }
    animate name-opacity { duration: 200ms; }

    width: 19 * root.rem;
    height: 11.4 * root.rem;

    // Baked for a resting-size tile (bake::shadow_rect): blur 4.78rem around
    // it, offset (2.2 * 1.12 + 0.5)rem down. Kept at a fixed size; it only fades.
    if root.lift > 0: Image {
        x: -(3.2 * 1.12 + 1.2) * root.rem;
        y: (2.2 * 1.12 + 0.5 - 3.2 * 1.12 - 1.2) * root.rem;
        width: (19 + 2 * (3.2 * 1.12 + 1.2)) * root.rem;
        height: (11.4 + 2 * (3.2 * 1.12 + 1.2)) * root.rem;
        source: root.shadow;
        image-fit: fill;
        opacity: root.lift;
    }

    Rectangle {
        width: 19 * root.rem * root.s;
        height: 11.4 * root.rem * root.s;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        Image {
            width: 100%;
            height: 100%;
            source: root.app.face;
            image-fit: fill;
        }

        Text {
            width: 100%;
            height: 100%;
            text: root.app.glyph;
            font-size: 5 * root.rem * root.s;
            font-weight: 700;
            color: #ffffffeb;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Running marker: fixed size and position, nothing animated.
    if root.app.running: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height + 0.9 * root.rem;
        width: 0.7 * root.rem;
        height: 0.7 * root.rem;
        border-radius: self.width / 2;
        background: Theme.text;
    }

    Text {
        y: root.height + 1.9 * root.rem;
        width: root.width;
        text: root.app.name;
        font-size: 1.5 * root.rem;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
        opacity: root.name-opacity;
    }
}
