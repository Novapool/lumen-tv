export global Theme {
    out property <color> bg: #05060a;
    out property <color> text: #f4f5f8;
    out property <color> muted: #9aa0ad;
    out property <color> pass: #3ccf6e;
    out property <color> fail: #ff5a5a;
    // Shared focus easing (CSS cubic-bezier(0.2, 0.8, 0.2, 1) in M1).
    out property <easing> ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
}
